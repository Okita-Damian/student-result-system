# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings


# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=3000

# ==========================================
# CORS CONFIGURATION
# Use your actual frontend origins.
# Example ports: Vite 5173, another frontend 3001.
# ==========================================
CORS_ORIGINS=

# ==========================================
# SWAGGER CONFIGURATION
# Enabled automatically outside production.
# ==========================================
ENABLE_SWAGGER=false

# ==========================================
# TRUSTED PROXY CONFIGURATION
# Leave unset for local development unless
# you actually run behind a trusted proxy.
# ==========================================
# TRUST_PROXY_HOPS=1

# ==========================================
# DATABASE
# Replace the example with your actual credentials.
# ==========================================
DATABASE_URL=

# ==========================================
# JWT AUTHENTICATION
# Use strong, random secrets of at least 32 characters.
# ==========================================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=


# ==========================================
# BREVO EMAIL CONFIGURATION
# ==========================================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=


# Frontend routes used in email magic links.
FRONTEND_URL=

EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=
PASSWORD_RESET_TOKEN_TTL_MINUTES=

# ==========================================
# CLOUDINARY IMAGE STORAGE
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Super Administrator Seed
ADMIN_FULL_NAME="IMSU System Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=